{
  "builds": [
    {
      "src": "store/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "static/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "store/wsgi.py"
    }
  ]
}
